{
    "appearance": {
        "theme": "light",
        "zoom": 1
    },
    "ipc": {
        "port": 6577,
        "timeouts": {
            "get_scene": 10,
            "watch": 30,
            "write": 60,
            "run_script": 30
        }
    },
    "bridge": {
        "keyframe_import_limit": 5000
    },
    "panels": {
        "hide_when_inactive": false,
        "nodes_view": "grid"
    },
    "node_editor": {
        "arrange": "network_simplex",
        "scroll": "auto"
    },
    "graph": {
        "time_units": "seconds",
        "show_handles": true,
        "show_preview": true,
        "preview_shape": "cube",
        "preview_grid": true
    },
    "console": {
        "debug": false,
        "overlay": true,
        "inline_lines": 5,
        "fade_seconds": 10,
        "profiler": false,
        "profiler_medium_ms": 4,
        "profiler_slow_ms": 16
    }
}